# station.conf - First-boot configuration for ShopperDB client stations
#
# Place this file on the SD card's boot partition before first insertion:
#   /boot/firmware/station.conf  (verify path with: findmnt /boot/firmware)
#
# The shopperdb-setup service reads this file on first boot to configure
# git credentials, clone the repo, run provisioning, and register with
# the server. Sensitive fields are zeroed after successful setup.
#
# This file is NOT checked into the repo. Use station.conf.example
# as the template.

# REQUIRED - Registration secret, supplied by ShopperDB
REGISTRATION_SECRET=

# REQUIRED - The server this station registers with.
# Use https://shopperdb.com unless you were told otherwise. create-image.sh /
# create-image.ps1 fill this in for you; only change it to point a test station
# at a development server.
SERVER_URL=https://shopperdb.com

# REQUIRED - GitHub access token, supplied by ShopperDB.
# The station uses it to download and update its software. Paste the token you
# were given; you do not create one yourself.
GITHUB_PAT=

# OPTIONAL - Admin SSH public key for passwordless login (recommended)
# Paste the full contents of your admin public key (e.g. ~/.ssh/id_ed25519.pub)
# This key is added to authorized_keys and password auth is disabled afterwards.
# Without this, password authentication remains active on the station.
ADMIN_SSH_KEY=

# OPTIONAL - Store page display name for this Pi's public inventory page.
# If set, a store page is auto-created when the admin accepts the station.
# Leave blank if this station should not have a public store page.
STORE_NAME=

# OPTIONAL - The store's web address, and the city/state it was built from.
# STORE_SLUG is the label before the domain (e.g. the "acme-hartford-ct" in
# https://acme-hartford-ct.example.com). The server uses it as given rather than
# deriving one, so the address is exactly what was approved when the card was
# written. It is a subdomain name, so it is capped at 63 characters and may hold
# only lowercase letters, numbers and hyphens.
#
# create-image.sh / create-image.ps1 fill these in and have you confirm the
# address once. Later cards for the same store reuse the confirmed address
# without asking again. Leave blank to let the server derive one from STORE_NAME.
#
# STORE_CITY is validated against a bundled list of US places and written in its
# canonical spelling, so "watertown" is stored as "Watertown". The city becomes
# part of the web address, where a misspelling would be permanent.
STORE_CITY=
STORE_STATE=
STORE_SLUG=

# OPTIONAL - Set to true to prevent a public store page from being created
# for this station. Useful for internal/test deployments. Default: false.
# When true, the store address fields above are ignored.
SKIP_STORE_CREATE=false

# OPTIONAL - Set to true to skip the printer test label during first provisioning.
# Useful if the label printer is not yet connected or you want to verify the
# rest of setup before printing. Default: false.
SKIP_TEST_PRINT=false

# OPTIONAL - Set to true to configure a 7-inch 1024x600 HDMI LCD on first boot.
# The Pi detects its own model (via /proc/device-tree/model) and applies the
# matching HDMI mode and USB power settings. Only enable this on units that
# actually have the LCD attached; it forces a 1024x600 HDMI mode that is wrong
# for a TV or headless station. Takes effect on the reboot after first boot.
# Default: false.
LCD_DISPLAY=false

# OPTIONAL - WiFi credentials (leave blank for Ethernet-only deployments)
WIFI_SSID=
WIFI_PASSWORD=
WIFI_COUNTRY=US

# OPTIONAL - Static IP (leave blank for DHCP, which is the default)
# Applies to whichever interface is active (WiFi if WIFI_SSID is set,
# Ethernet otherwise). Common prefix lengths: 24 = 255.255.255.0,
# 16 = 255.255.0.0
STATIC_IP=
STATIC_GATEWAY=
STATIC_PREFIX=24
STATIC_DNS=8.8.8.8,1.1.1.1
